      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(ml_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "title": "Inference Throughput (QPS)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
