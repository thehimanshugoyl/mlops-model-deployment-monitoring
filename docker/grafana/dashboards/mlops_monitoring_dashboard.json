          "range": false,
          "refId": "A"
        }
      ],
      "title": "Dataset Drift Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
